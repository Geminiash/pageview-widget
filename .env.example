# ---- pageview-widget 配置示例：复制为 .env 后按需修改 ----

# 监听端口
PORT=8787

# SQLite 数据库文件路径（Docker 内挂载 ./data 卷）
PV_DB_PATH=./data/pageview.db

# IP/UA 哈希盐值。必填！请改成一段随机字符串；固定不变才能保证重启后去重窗口仍然有效
PV_SALT=please-change-me-to-a-random-string

# 管理令牌：访问 /api/stats 需要；留空则完全禁用该接口
PV_ADMIN_TOKEN=

# 允许跨域上报的站点来源（逗号分隔）。同源请求自动放行，无需配置
ALLOW_ORIGINS=https://example.com

# 部署在反向代理（Nginx/Caddy 等）之后请设为 1，读取 X-Forwarded-For 获取真实访客 IP
PV_TRUST_PROXY=0

# 每秒每 IP 请求上限（0 = 不限频）
PV_RATE_MAX=10

# 托管的 widget 文件路径（默认 dist/widget.js，一般无需修改）
# PV_WIDGET_PATH=dist/widget.js
